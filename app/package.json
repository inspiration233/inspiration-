{
  "name": "team-toolbox",
  "productName": "工具箱",
  "version": "0.3.0",
  "description": "本地 Excel 工作台：原生合并、拆分与对照回填",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "test:ui": "electron . --workbench-test"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.inspiration.teamtoolbox",
    "productName": "工具箱",
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.js",
      "preload.js",
      "shell/**",
      "shared/**",
      "tools/**",
      "package.json",
      "workbench-smoke.js"
    ],
    "extraResources": [
      {
        "from": "../dist-engine/current",
        "to": "engine-sidecar"
      }
    ],
    "asarUnpack": [],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "工具箱-Setup-${version}.${ext}",
      "createDesktopShortcut": "always"
    },
    "dmg": {
      "artifactName": "工具箱-${version}-${arch}.${ext}"
    },
    "afterPack": "./afterpack.js"
  }
}
